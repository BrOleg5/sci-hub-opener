{
  "manifest_version": 2,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "version": "1.0.0",
  "default_locale": "en",
  "homepage_url": "https://github.com/BrOleg5/sci-hub-pdf-opener",

  "browser_specific_settings": {
    "gecko": {
      "id": "sci-hub-pdf-opener@brolegg",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },

  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "contextMenus",
    "<all_urls>"
  ],

  "background": {
    "scripts": [
      "lib/doi.js",
      "lib/settings.js",
      "lib/scihub.js",
      "background/background.js"
    ]
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/doi.js", "lib/scihub.js", "content/doi-finder.js"],
      "run_at": "document_idle"
    }
  ],

  "browser_action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "__MSG_actionTitle__"
  },

  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },

  "commands": {
    "open-in-scihub": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "__MSG_commandOpen__"
    }
  }
}
